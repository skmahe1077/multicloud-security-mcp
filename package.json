{
  "name": "multicloud-security-mcp",
  "version": "1.0.1",
  "description": "Multi-Cloud Security MCP Server — unified security visibility across AWS, Azure, and GCP for AI agents and Claude Desktop",
  "type": "module",
  "main": "dist/lib.js",
  "types": "dist/lib.d.ts",
  "bin": {
    "multicloud-security-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/lib.d.ts",
      "import": "./dist/lib.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "iam-policy-aws.json",
    "rbac-azure.json",
    "iam-roles-gcp.txt",
    ".env.example",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "build:python": "cd python && pip install --upgrade build && python -m build",
    "prepublishOnly": "npm run clean && npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "security",
    "cloud-security",
    "aws",
    "azure",
    "gcp",
    "multicloud",
    "claude",
    "ai-agent",
    "siem",
    "compliance",
    "vulnerability",
    "iam",
    "guardduty",
    "defender",
    "security-command-center",
    "devsecops"
  ],
  "author": "Mahendran Selvakumar",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skmahe1077/multicloud-security-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/skmahe1077/multicloud-security-mcp/issues"
  },
  "homepage": "https://github.com/skmahe1077/multicloud-security-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",

    "@aws-sdk/client-securityhub": "^3.700.0",
    "@aws-sdk/client-guardduty": "^3.700.0",
    "@aws-sdk/client-inspector2": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-accessanalyzer": "^3.700.0",
    "@aws-sdk/client-macie2": "^3.700.0",
    "@aws-sdk/client-cloudtrail": "^3.700.0",
    "@aws-sdk/client-detective": "^3.700.0",
    "@aws-sdk/client-config-service": "^3.700.0",
    "@aws-sdk/client-wafv2": "^3.700.0",
    "@aws-sdk/client-shield": "^3.700.0",
    "@aws-sdk/client-network-firewall": "^3.700.0",
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-kms": "^3.700.0",
    "@aws-sdk/client-ecr": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",

    "@azure/arm-security": "^5.0.0",
    "@azure/arm-securityinsight": "^1.0.0-beta.6",
    "@azure/arm-authorization": "^9.0.0",
    "@azure/arm-policy": "^6.0.0",
    "@azure/arm-policyinsights": "^6.0.0",
    "@azure/arm-keyvault": "^4.0.0",
    "@azure/arm-network": "^36.0.0",
    "@azure/arm-containerregistry": "^11.0.0",
    "@azure/arm-appservice": "^18.0.0",
    "@azure/arm-monitor": "^8.0.0-beta.6",
    "@azure/identity": "^4.0.0",
    "@microsoft/microsoft-graph-client": "^3.0.0",

    "@google-cloud/security-center": "^8.0.0",
    "@google-cloud/dlp": "^4.0.0",
    "@google-cloud/kms": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/asset": "^5.0.0",
    "@google-cloud/logging": "^11.0.0",
    "googleapis": "^140.0.0",

    "zod": "^3.23.0",
    "winston": "^3.14.0",
    "p-limit": "^6.1.0",
    "dotenv": "^16.4.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
