# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=eu-west-1
AWS_PROFILE=
AWS_ACCOUNT_ID=

# Azure
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_LOG_ANALYTICS_WORKSPACE_ID=

# GCP
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
GCP_ORGANIZATION_ID=
GCP_LOCATION=global

# Server
LOG_LEVEL=info
LOG_MASK_ACCOUNT_IDS=true
ENABLE_REMEDIATION=false
MCP_SERVER_NAME=multicloud-security-mcp
MCP_SERVER_VERSION=1.0.0
CACHE_TTL_SECONDS=300
